/* ==========================================================================
   ESTILOS GERAIS E INTERFACE NEON SYNTHWAVE
   ========================================================================== */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    user-select: none;
    -webkit-user-select: none;
    touch-action: none;
}

body, html {
    width: 100%;
    height: 100%;
    overflow: hidden;
    background-color: #050508;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    color: #fff;
    display: flex;
    justify-content: center;
    align-items: center;
}

#game-wrapper {
    position: relative;
    width: 100vw;
    height: 100vh;
    max-width: 600px;
    max-height: 900px;
    background: #080811;
    box-shadow: 0 0 30px rgba(0, 229, 255, 0.2), 0 0 80px rgba(255, 0, 128, 0.1);
    overflow: hidden;
}

canvas {
    display: block;
    width: 100%;
    height: 100%;
}

.ui-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 15px;
    z-index: 10;
}

.hud-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    font-weight: 800;
}

.score-box {
    font-size: 1.1rem;
    letter-spacing: 2px;
    color: #00e5ff;
}

.score-val {
    font-size: 1.8rem;
    color: #fff;
}

.credits-val {
    font-size: 0.8rem;
    color: #00ff66;
    margin-top: 2px;
}

.combo-badge {
    background: #ff007f;
    color: #fff;
    font-size: 0.65rem;
    padding: 2px 6px;
    border-radius: 8px;
    vertical-align: middle;
}

.hud-btn {
    pointer-events: auto;
    background: rgba(0, 229, 255, 0.1);
    border: 1px solid #00e5ff;
    color: #00e5ff;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    font-size: 1.2rem;
    cursor: pointer;
}

.health-container {
    width: 130px;
    text-align: right;
}

.ult-label-box {
    display: flex;
    justify-content: space-between;
    font-size: 0.65rem;
    color: #ff00ff;
    margin-top: 6px;
    font-weight: 700;
    letter-spacing: 1px;
}

.bar-bg {
    width: 100%;
    height: 10px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 5px;
    overflow: hidden;
    margin-top: 3px;
}

.ult-bar-bg {
    height: 6px;
    border-color: rgba(255, 0, 255, 0.4);
}

.bar-fill {
    height: 100%;
    transition: width 0.2s ease-out;
}

.health-fill { background: linear-gradient(90deg, #ff0055, #00e5ff); }
.ult-fill { background: linear-gradient(90deg, #aa00ff, #ff00ff); }

/* Selector de Dificuldade */
.difficulty-container {
    margin-bottom: 15px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
}

.diff-label {
    font-size: 0.75rem;
    color: #00e5ff;
    letter-spacing: 1.5px;
    font-weight: 800;
}

.diff-selector {
    display: flex;
    gap: 6px;
    background: rgba(255, 255, 255, 0.05);
    padding: 4px;
    border-radius: 12px;
    border: 1px solid rgba(0, 229, 255, 0.2);
}

.btn-diff {
    background: transparent;
    border: none;
    color: #a0a0c0;
    padding: 6px 12px;
    font-size: 0.7rem;
    font-weight: 800;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
}

.btn-diff.active {
    background: #00e5ff;
    color: #050508;
    box-shadow: 0 0 8px rgba(0, 229, 255, 0.6);
}

.btn-diff[data-diff="HARD"].active {
    background: #ffaa00;
    box-shadow: 0 0 8px rgba(255, 170, 0, 0.6);
}

.btn-diff[data-diff="EXTREME"].active {
    background: #ff0055;
    color: #fff;
    box-shadow: 0 0 8px rgba(255, 0, 85, 0.8);
}

/* Alerta de Dificuldade Adaptada */
.adaptive-indicator {
    position: absolute;
    top: 35%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: rgba(255, 0, 85, 0.25);
    border: 2px solid #ff0055;
    color: #fff;
    padding: 12px 20px;
    border-radius: 12px;
    font-size: 0.85rem;
    font-weight: 900;
    letter-spacing: 1.5px;
    text-align: center;
    box-shadow: 0 0 20px rgba(255, 0, 85, 0.6);
    backdrop-filter: blur(4px);
    transition: opacity 0.5s ease-in-out;
    pointer-events: none;
    width: 85%;
}

/* Botões de Ação Touch */
.action-buttons-container {
    display: flex;
    justify-content: space-between;
    pointer-events: auto;
    margin-top: 10px;
}

.action-btn {
    background: rgba(5, 5, 12, 0.7);
    border: 2px solid #00e5ff;
    color: #00e5ff;
    padding: 10px 18px;
    border-radius: 20px;
    font-weight: 800;
    font-size: 0.8rem;
    cursor: pointer;
}

.ult-btn {
    border-color: #ff00ff;
    color: #ff00ff;
}

/* Chefe */
.boss-health-container {
    width: 100%;
    margin-top: 10px;
    text-align: center;
}

.boss-title {
    font-size: 0.8rem;
    font-weight: 800;
    color: #ff0055;
    letter-spacing: 2px;
}

.boss-bar-bg {
    width: 100%;
    height: 12px;
    background: rgba(255, 0, 85, 0.1);
    border: 1px solid #ff0055;
    border-radius: 6px;
    overflow: hidden;
    margin-top: 4px;
}

.boss-bar-fill {
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, #ffaa00, #ff0055);
}

/* Telas Overlay */
.overlay-screen {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(5, 5, 12, 0.9);
    backdrop-filter: blur(8px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 25px;
    pointer-events: auto;
    z-index: 20;
}

.hidden { opacity: 0; pointer-events: none !important; }

.title-main {
    font-size: 2.4rem;
    font-weight: 900;
    font-style: italic;
    background: linear-gradient(45deg, #00e5ff, #ff007f);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 5px;
}

.title-secondary {
    font-size: 1.8rem;
    color: #00e5ff;
    margin-bottom: 5px;
}

.subtitle { font-size: 0.85rem; color: #a0a0c0; letter-spacing: 2px; margin-bottom: 20px; }

.main-menu-btns, .pause-menu-btns {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: center;
}

.btn-neon {
    background: transparent;
    border: 2px solid #00e5ff;
    color: #00e5ff;
    padding: 12px 30px;
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 2px;
    border-radius: 25px;
    cursor: pointer;
    box-shadow: 0 0 12px rgba(0, 229, 255, 0.4);
    width: 240px;
}

.btn-neon.btn-secondary { border-color: #ff007f; color: #ff007f; box-shadow: 0 0 12px rgba(255, 0, 127, 0.4); }

.instructions { margin-top: 25px; font-size: 0.8rem; color: #707090; line-height: 1.5; }

/* Loja */
.shop-items { width: 100%; max-width: 380px; display: flex; flex-direction: column; gap: 12px; }

.shop-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(255, 255, 255, 0.05);
    padding: 12px 16px;
    border-radius: 10px;
    border: 1px solid rgba(0, 229, 255, 0.2);
    text-align: left;
}

.shop-desc { font-size: 0.75rem; color: #a0a0c0; }

.btn-shop {
    background: #00ff66;
    color: #050508;
    border: none;
    padding: 8px 14px;
    border-radius: 15px;
    font-weight: 900;
    cursor: pointer;
}

/* Tabela de Líderes */
.leaderboard-list { width: 100%; max-width: 360px; display: flex; flex-direction: column; gap: 8px; }

.leader-row {
    display: flex;
    justify-content: space-between;
    background: rgba(255, 255, 255, 0.05);
    padding: 10px 15px;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.9rem;
}

.name-input-container { display: flex; gap: 10px; margin-top: 15px; }

#playerNameInput {
    background: #101020;
    border: 1px solid #00e5ff;
    color: #fff;
    padding: 8px 12px;
    border-radius: 8px;
    font-weight: 700;
    text-align: center;
    outline: none;
}

.powerup-indicator {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.85rem;
    font-weight: 700;
    color: #ffcc00;
    opacity: 0;
    transition: opacity 0.3s;
}
